---
import Icon from '../Icon.astro';
import { withBase } from '../../lib/url';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-caption text-ink-secondary">
    {items.map((crumb, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <Icon name="chevron-right" size={12} class="text-mist" />}
        {crumb.href ? (
          <a href={withBase(crumb.href)} class="transition-colors hover:text-ink-primary">
            {crumb.label}
          </a>
        ) : (
          <span class="font-medium text-ink-primary" aria-current="page">
            {crumb.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
