---
import Icon from '../Icon.astro';

interface Props {
  variant?: 'info' | 'success' | 'warning' | 'danger';
  title?: string;
  class?: string;
}

const { variant = 'info', title, class: className = '' } = Astro.props;

// Colour never carries the meaning on its own — each variant pairs its tint
// with an icon that says the same thing.
const variants = {
  info: { tone: 'bg-info/10 text-info', icon: 'info' },
  success: { tone: 'bg-success/10 text-success', icon: 'circle-check' },
  warning: { tone: 'bg-warning/10 text-warning', icon: 'triangle-alert' },
  danger: { tone: 'bg-danger/10 text-danger', icon: 'circle-alert' },
};

const { tone, icon } = variants[variant];
---

<div
  role={variant === 'danger' ? 'alert' : 'status'}
  class:list={['flex gap-3 rounded-control p-4', tone, className]}
>
  <Icon name={icon} size={20} class="mt-0.5 shrink-0" />
  <div class="min-w-0 text-caption">
    {title && <p class="font-semibold">{title}</p>}
    <div class:list={['text-ink-secondary', title && 'mt-1']}>
      <slot />
    </div>
  </div>
</div>
