---
import Icon from '../Icon.astro';

interface Props {
  label: string;
  value: string;
  /** Signed percentage change, e.g. `+12.4%`. Direction is read from the sign. */
  change?: string;
  /** Whether a rise is good news. Churn rises are not. */
  higherIsBetter?: boolean;
  caption?: string;
  icon?: string;
}

const { label, value, change, higherIsBetter = true, caption, icon } = Astro.props;

const rising = change?.trim().startsWith('+');
const good = rising === higherIsBetter;
---

<div class="rounded-card border border-hairline bg-surface-card p-5">
  <div class="flex items-start justify-between gap-3">
    <p class="text-caption text-ink-secondary">{label}</p>
    {icon && <Icon name={icon} size={18} class="shrink-0 text-ink-secondary" />}
  </div>

  {/* The hero number carries the tile — everything else is support. */}
  <p class="tabular mt-2 text-heading-sm font-semibold">{value}</p>

  {(change || caption) && (
    <div class="mt-2 flex items-center gap-2 text-micro">
      {change && (
        <span
          class:list={['inline-flex items-center gap-0.5', good ? 'text-success' : 'text-danger']}
        >
          <Icon name={rising ? 'arrow-up-right' : 'arrow-down-right'} size={14} />
          <span class="tabular font-medium">{change}</span>
        </span>
      )}
      {caption && <span class="text-ink-secondary">{caption}</span>}
    </div>
  )}
</div>
