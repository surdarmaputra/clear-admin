---
import Icon from '../Icon.astro';
import Sparkline from './Sparkline.astro';

interface Props {
  label: string;
  value: string;
  /** Signed percentage change, e.g. `+12.4%`. Direction is read from the sign. */
  change?: string;
  /** Whether a rise is good news. Churn rises are not. */
  higherIsBetter?: boolean;
  caption?: string;
  icon?: string;
  /** Categorical slot for the tile's tint. Decorative identity, never status. */
  tone?: 1 | 2 | 3 | 7;
  /** Recent history for the sparkline. Omit and the tile stays flat. */
  trend?: number[];
}

const { label, value, change, higherIsBetter = true, caption, icon, tone = 1, trend } = Astro.props;

// Drawn from the categorical palette, not the status one — a tile is an
// identity, not a state. The wash is deliberately weak: it has to tint the
// card without dragging the hero number's contrast down with it.
const tones = {
  1: { chip: 'bg-series-1/12 text-series-1', wash: 'from-series-1/8', edge: 'bg-series-1' },
  2: { chip: 'bg-series-2/12 text-series-2', wash: 'from-series-2/8', edge: 'bg-series-2' },
  3: { chip: 'bg-series-3/12 text-series-3', wash: 'from-series-3/8', edge: 'bg-series-3' },
  7: { chip: 'bg-series-7/12 text-series-7', wash: 'from-series-7/8', edge: 'bg-series-7' },
};

const { chip, wash, edge } = tones[tone];

const rising = change?.trim().startsWith('+');
const good = rising === higherIsBetter;
---

<div class="group relative overflow-hidden rounded-card border border-hairline bg-surface-card shadow-card transition-shadow hover:shadow-raised">
  {/* Tint sits in its own layer so the card surface token stays untouched and
      dark mode needs no second set of values. */}
  <div
    aria-hidden="true"
    class:list={['pointer-events-none absolute inset-0 bg-gradient-to-br to-transparent', wash]}
  ></div>

  {/* A hairline of the tone across the top — the tile's identity read at a
      glance, before any of the text is parsed. */}
  <div aria-hidden="true" class:list={['absolute inset-x-0 top-0 h-0.5', edge]}></div>

  <div class="relative p-5">
    <div class="flex items-start justify-between gap-3">
      <p class="text-micro font-medium tracking-label text-ink-secondary uppercase">{label}</p>
      {icon && (
        <span class:list={['grid size-8 shrink-0 place-items-center rounded-control', chip]}>
          <Icon name={icon} size={16} />
        </span>
      )}
    </div>

    {/* The hero number carries the tile — everything else is support. */}
    <p class="tabular font-display mt-3 text-heading-sm font-semibold tracking-display">{value}</p>

    <div class="mt-2 flex items-end justify-between gap-3">
      {(change || caption) && (
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-micro">
          {change && (
            <span
              class:list={[
                'inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 font-medium',
                good ? 'bg-success/12 text-success' : 'bg-danger/12 text-danger',
              ]}
            >
              <Icon name={rising ? 'arrow-up-right' : 'arrow-down-right'} size={13} />
              <span class="tabular">{change}</span>
            </span>
          )}
          {caption && <span class="text-ink-secondary">{caption}</span>}
        </div>
      )}

      {trend && <Sparkline points={trend} tone={tone} class="h-7 w-16 shrink-0" />}
    </div>
  </div>
</div>
