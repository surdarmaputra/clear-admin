---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class:list={['rounded-card border border-hairline bg-surface-card p-6', className]}>
  {(title || description) && (
    <div class="mb-4">
      {title && <h2 class="text-title-sm font-semibold">{title}</h2>}
      {description && <p class="mt-1 text-caption text-ink-secondary">{description}</p>}
    </div>
  )}
  <slot />
</div>
