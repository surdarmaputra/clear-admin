---
interface Props {
  id: string;
  label: string;
  name?: string;
  value?: string;
  checked?: boolean;
  hint?: string;
  disabled?: boolean;
}

const { id, label, name = id, value, checked = false, hint, disabled = false } = Astro.props;
---

<div class="flex gap-2.5">
  <input
    id={id}
    name={name}
    type="checkbox"
    value={value}
    checked={checked}
    disabled={disabled}
    aria-describedby={hint ? `${id}-hint` : undefined}
    class="mt-0.5 size-4 shrink-0 cursor-pointer rounded-[4px] border border-hairline bg-surface-card text-accent accent-accent disabled:cursor-not-allowed disabled:opacity-60"
  />
  <div class="min-w-0">
    <label for={id} class="cursor-pointer text-caption">
      {label}
    </label>
    {hint && (
      <p id={`${id}-hint`} class="text-micro text-ink-secondary">
        {hint}
      </p>
    )}
  </div>
</div>
