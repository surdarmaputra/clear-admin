---
import Field from './Field.astro';
import { controlClass, describedBy } from './control';

interface Props {
  id: string;
  label: string;
  name?: string;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  placeholder?: string;
  value?: string;
  autocomplete?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  placeholder,
  value,
  autocomplete,
  hint,
  error,
  required = false,
  disabled = false,
} = Astro.props;
---

<Field id={id} label={label} hint={hint} error={error} required={required}>
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    autocomplete={autocomplete}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy(id, hint, error)}
    class:list={[controlClass, error && 'border-danger']}
  />
</Field>
