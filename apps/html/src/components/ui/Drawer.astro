---
import Icon from '../Icon.astro';

interface Props {
  /** Name the trigger opens: `$store.overlay.open('<id>')`. */
  id: string;
  title: string;
  side?: 'left' | 'right';
}

const { id, title, side = 'right' } = Astro.props;
---

<template x-teleport="body">
  <div
    x-show={`$store.overlay.is('${id}')`}
    x-on:keydown.escape.window="$store.overlay.close()"
    x-transition.opacity.duration.200ms
    x-cloak
    class="fixed inset-0 z-50"
  >
    <div
      x-on:click="$store.overlay.close()"
      class="absolute inset-0 bg-graphite/50"
      aria-hidden="true"
    ></div>

    <div
      x-show={`$store.overlay.is('${id}')`}
      x-focus-trap={`$store.overlay.is('${id}')`}
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start={side === 'right' ? 'translate-x-full' : '-translate-x-full'}
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end={side === 'right' ? 'translate-x-full' : '-translate-x-full'}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`${id}-title`}
      class:list={[
        'absolute inset-y-0 flex w-full max-w-sm flex-col bg-surface-card shadow-raised',
        side === 'right' ? 'right-0' : 'left-0',
      ]}
    >
      <div class="flex items-center gap-3 border-b border-hairline p-4">
        <h2
          id={`${id}-title`}
          class="font-display min-w-0 flex-1 text-subheading font-semibold tracking-display"
        >
          {title}
        </h2>
        <button
          type="button"
          x-on:click="$store.overlay.close()"
          aria-label="Close drawer"
          class="grid size-8 shrink-0 place-items-center rounded-control text-ink-secondary transition-colors hover:bg-surface-hover hover:text-ink-primary"
        >
          <Icon name="x" size={16} />
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4 text-caption text-ink-secondary">
        <slot />
      </div>

      <div class="flex justify-end gap-2 border-t border-hairline p-4">
        <slot name="footer" />
      </div>
    </div>
  </div>
</template>
