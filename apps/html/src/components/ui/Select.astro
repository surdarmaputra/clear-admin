---
import Field from './Field.astro';
import Icon from '../Icon.astro';
import { controlClass, describedBy } from './control';

interface Props {
  id: string;
  label: string;
  name?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
}

const { id, label, name = id, hint, error, required = false, disabled = false } = Astro.props;
---

<Field id={id} label={label} hint={hint} error={error} required={required}>
  <div class="relative">
    <select
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy(id, hint, error)}
      class:list={[controlClass, 'appearance-none pr-9', error && 'border-danger']}
    >
      <slot />
    </select>
    <Icon
      name="chevron-down"
      size={16}
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-ink-secondary"
    />
  </div>
</Field>
