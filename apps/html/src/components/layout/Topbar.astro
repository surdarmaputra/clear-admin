---
import Icon from '../Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import Dropdown from '../ui/Dropdown.astro';
import DropdownItem from '../ui/DropdownItem.astro';
import { withBase } from '../../lib/url';

interface Props {
  title: string;
  breadcrumb?: { label: string; href?: string }[];
}

const { title, breadcrumb = [] } = Astro.props;
---

<header class="sticky top-0 z-20 flex h-14 items-center gap-3 bg-surface-page px-4">
  <button
    type="button"
    x-on:click="mobileOpen = true"
    aria-label="Open navigation"
    class="grid size-9 place-items-center rounded-control text-ink-secondary transition-colors hover:bg-surface-hover hover:text-ink-primary lg:hidden"
  >
    <Icon name="menu" size={18} />
  </button>

  <div class="min-w-0 flex-1">
    {breadcrumb.length > 0 ? (
      <Breadcrumb items={breadcrumb} />
    ) : (
      <h1 class="font-display truncate text-subheading font-semibold tracking-display">{title}</h1>
    )}
  </div>

  <button
    type="button"
    aria-label="Notifications"
    class="relative grid size-9 place-items-center rounded-control text-ink-secondary transition-colors hover:bg-surface-hover hover:text-ink-primary"
  >
    <Icon name="bell" size={18} />
    <span class="absolute right-2 top-2 size-1.5 rounded-full bg-electric-blue"></span>
  </button>

  <ThemeToggle />

  <Dropdown label="Account" align="right">
    <button
      slot="trigger"
      type="button"
      x-ref="trigger"
      x-on:click="toggle()"
      x-bind:aria-expanded="open"
      aria-haspopup="menu"
      aria-label="Account"
      class="flex items-center gap-2 rounded-control p-1 transition-colors hover:bg-surface-hover"
    >
      <span class="grid size-7 place-items-center rounded-full bg-surface-hover text-micro font-semibold text-ink-primary">
        SD
      </span>
      <Icon name="chevron-down" size={14} class="text-ink-secondary" />
    </button>

    <DropdownItem href={withBase('/profile')} icon="user">
      Profile
    </DropdownItem>
    <DropdownItem href={withBase('/settings')} icon="settings">
      Settings
    </DropdownItem>
    <div class="my-1 border-t border-hairline"></div>
    <DropdownItem href={withBase('/login')} icon="log-out" tone="danger">
      Sign out
    </DropdownItem>
  </Dropdown>
</header>
