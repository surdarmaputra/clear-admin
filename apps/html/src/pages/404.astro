---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---

<DashboardLayout title="Page not found" breadcrumb={[{ label: 'Page not found' }]}>
  <div class="grid min-h-[60vh] place-items-center rounded-card border border-hairline bg-surface-card p-6">
    <div class="max-w-sm text-center">
      <span class="inline-grid size-12 place-items-center rounded-full bg-surface-hover text-ink-secondary">
        <Icon name="compass" size={24} />
      </span>
      <p class="mt-4 text-heading-sm font-semibold">404</p>
      <h2 class="mt-1 text-title-sm font-semibold">Page not found</h2>
      <p class="mt-2 text-caption text-ink-secondary">
        The page you are looking for was moved, renamed, or never existed.
      </p>
      <Button href={withBase('/')} class="mt-6">
        Back to dashboard
      </Button>
    </div>
  </div>
</DashboardLayout>
