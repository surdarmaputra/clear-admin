---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Alert from '../../components/ui/Alert.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import ErrorState from '../../components/ui/ErrorState.astro';
import Skeleton from '../../components/ui/Skeleton.astro';
import Spinner from '../../components/ui/Spinner.astro';

const breadcrumb = [{ label: 'Components' }, { label: 'Feedback' }];

const toasts = [
  { variant: 'info', label: 'Info', message: 'Export queued — we will email the link.' },
  { variant: 'success', label: 'Success', message: 'Changes saved.' },
  { variant: 'warning', label: 'Warning', message: 'Two rows were skipped.' },
  { variant: 'danger', label: 'Danger', message: 'Could not reach the server.' },
];
---

<DashboardLayout title="Feedback" breadcrumb={breadcrumb}>
  <div class="flex max-w-4xl flex-col gap-6">
    <div>
      <h1 class="font-display text-title font-semibold tracking-display">Feedback</h1>
      <p class="mt-1 text-caption text-ink-secondary">
        What the interface says back. Toasts announce through a polite live region; every tint is
        paired with an icon, so colour never carries the meaning alone.
      </p>
    </div>

    <Card
      title="Toast"
      description="Raise one from anywhere with $store.toast.show(message, variant)."
    >
      <div class="flex flex-wrap gap-3">
        {toasts.map(({ variant, label, message }) => (
          <Button variant="secondary" x-on:click={`$store.toast.show('${message}', '${variant}')`}>
            {label}
          </Button>
        ))}
        <Button
          variant="ghost"
          x-on:click="$store.toast.show('This one stays until dismissed.', 'info', 0)"
        >
          Persistent
        </Button>
      </div>
    </Card>

    <Card title="Alert" description="Inline, and it stays until the condition is gone.">
      <div class="flex flex-col gap-3">
        <Alert variant="info" title="Scheduled maintenance">
          The API is read-only on Sunday between 02:00 and 04:00 UTC.
        </Alert>
        <Alert variant="success" title="Invoice sent">
          Ada will get it within a few minutes.
        </Alert>
        <Alert variant="warning" title="Card expiring">
          The card on file expires next month.
        </Alert>
        <Alert variant="danger" title="Payment failed">
          The last charge was declined. Update the card to keep the plan active.
        </Alert>
      </div>
    </Card>

    <div class="grid gap-6 lg:grid-cols-2">
      <Card title="Empty state" class="flex flex-col">
        <EmptyState
          title="No orders yet"
          description="Orders appear here once a customer checks out."
        >
          <Button variant="secondary">Create test order</Button>
        </EmptyState>
      </Card>

      <Card title="Error state" class="flex flex-col">
        <ErrorState>
          <Button variant="secondary">Try again</Button>
        </ErrorState>
      </Card>

      <Card title="Loading — skeleton" description="Holds the shape the content will take.">
        <div class="flex flex-col gap-3">
          <Skeleton class="h-4 w-1/3" />
          <Skeleton class="h-4 w-full" />
          <Skeleton class="h-4 w-5/6" />
          <Skeleton class="h-24 w-full" />
        </div>
      </Card>

      <Card title="Loading — spinner" description="For a wait too short to be worth a skeleton.">
        <div class="flex items-center gap-3 py-6 text-caption text-ink-secondary">
          <Spinner label="Loading orders" />
          Loading orders…
        </div>
      </Card>
    </div>
  </div>
</DashboardLayout>
