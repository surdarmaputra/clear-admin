---
import AuthLayout from '../layouts/AuthLayout.astro';
import Alert from '../components/ui/Alert.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import { withBase } from '../lib/url';
---

<AuthLayout
  title="Reset password"
  heading="Reset password"
  subheading="We will email you a link to choose a new one."
>
  <div x-data="{ sent: false }">
    <form
      class="flex flex-col gap-4"
      method="post"
      action="#"
      x-show="!sent"
      x-on:submit.prevent="sent = true"
    >
      <Input
        id="email"
        label="Email"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
      />
      <Button type="submit" class="w-full">
        Send reset link
      </Button>
    </form>

    {/* The success state is part of the page, not a separate screen — the
        consumer swaps the Alpine flag for their own server response. */}
    <div x-show="sent" x-cloak class="flex flex-col gap-4">
      <Alert variant="success" title="Check your inbox">
        If an account exists for that address, a reset link is on its way.
      </Alert>
      <Button variant="secondary" href={withBase('/login')} class="w-full">
        Back to sign in
      </Button>
    </div>
  </div>

  <p slot="footer" class="mt-6 text-center text-caption text-ink-secondary">
    Remembered it?
    <a href={withBase('/login')} class="text-accent hover:underline">
      Sign in
    </a>
  </p>
</AuthLayout>
